# Homelander headless scanner — copy to .env next to docker-compose.yml.
# .env is gitignored; never commit real values.

# ── Searches ────────────────────────────────────────────────────
# Comma- or newline-separated search URLs (IS24 buy, Kleinanzeigen,
# Neubaukompass). Synced into the DB on container start.
HOMELANDER_SCAN_URLS=https://www.immobilienscout24.de/Suche/de/berlin/berlin/wohnung-kaufen?price=-600000

# Poll interval in seconds
HOMELANDER_POLL_INTERVAL=600

TZ=Europe/Berlin

# ── Weekly e-mail report (optional) — ProtonMail SMTP ───────────
# user = the custom-domain Proton address the SMTP token is paired with
# (Proton SMTP tokens: Unlimited plan or higher, custom-domain address —
# not @protonmail.com). password = the SMTP token. From must equal the
# user address; it defaults to it, so no HOMELANDER_SMTP_FROM needed.
HOMELANDER_REPORT_ENABLED=false
HOMELANDER_REPORT_TO=you@example.com

# Shortlist thresholds for the mail only — the Kaufradar map keeps showing
# everything. Set any of them to 0 to drop that criterion.
# The walking time is a straight-line estimate to the nearest U-/S-Bahn stop
# (80 m/min with a 1.3x detour factor, so 10 min ~ 615 m as the crow flies);
# for listings without exposé coordinates it is measured from the postcode
# centroid and the mail marks it "ca.".
HOMELANDER_REPORT_MIN_SIZE=80
HOMELANDER_REPORT_MIN_ROOMS=4
HOMELANDER_REPORT_MAX_WALK_MINUTES=10
# The mail carries flats only (house searches are left out), and the walk is
# measured only to stops between the Hbf and these outer stops: everything
# inside the convex hull of Hamburg Hauptbahnhof and the listed stops.
# Comma-separated; empty = any stop in Hamburg.
HOMELANDER_REPORT_WEST_STATIONS=Lutterothstraße,Langenfelde,Bahrenfeld,Lattenkamp,Sierichstraße
# Stops counted on top of that area: U3 Feldstraße→Hbf, S-Bahn Altona→Hbf.
HOMELANDER_REPORT_EXTRA_STATIONS=St. Pauli,Landungsbrücken,Baumwall,Rödingsmarkt,Rathaus,Hauptbahnhof Süd,Hamburg-Altona,Königstraße,Reeperbahn,Stadthausbrücke

HOMELANDER_SMTP_HOST=smtp.protonmail.ch
HOMELANDER_SMTP_PORT=587
HOMELANDER_SMTP_USER=homelander@your-domain.eu
HOMELANDER_SMTP_PASSWORD=
# HOMELANDER_SMTP_SECURE=starttls   # ssl | starttls | none
# HOMELANDER_SMTP_FROM=             # defaults to HOMELANDER_SMTP_USER

# ── Accounts (optional) ─────────────────────────────────────────
# accounts = every visitor logs in with their own name + password; seen/star
# flags, uploads and the weekly mail settings are then per person. Create
# accounts with:  docker exec -it homelander-scanner node engine/users-cli.js add <name> --email <addr>
# The first account inherits the flags/uploads/report that existed before.
# HOMELANDER_AUTH=accounts
